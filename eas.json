{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "development-store": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_ENV": "development",
        "APP_BUILD_CHANNEL": "testflight"
      },
      "ios": {
        "credentialsSource": "remote"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_ENV": "production"
      },
      "ios": {
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "development-store": {
      "ios": {
        "ascAppId": "6762039576",
        "bundleIdentifier": "com.detoxmate.app.dev"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6771277684",
        "bundleIdentifier": "com.detoxmate.app"
      }
    }
  }
}
